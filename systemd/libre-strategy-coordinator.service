[Unit]
Description=Libre Strategy Coordinator Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=libre
Group=libre
WorkingDirectory=/opt/libre/pylibre
ExecStart=/opt/libre/pylibre/.venv/bin/python scripts/run_strategy_coordinator.py --account ${ACCOUNT} --base ${BASE} --quote ${QUOTE} --config ${CONFIG_PATH} --dashboard --dashboard-port ${DASHBOARD_PORT}
Restart=on-failure
RestartSec=10
Environment="ACCOUNT=bentest3"
Environment="BASE=LIBRE"
Environment="QUOTE=BTC"
Environment="CONFIG_PATH=/opt/libre/pylibre/config/strategies.yaml"
Environment="DASHBOARD_PORT=5000"
# Uncomment and modify these if needed for API keys or other secrets
#EnvironmentFile=/etc/libre/env

# Security settings
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target 